{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.apps.dsh;

  # Keep in step with ../claude-code/cronometer.
  cronometer-mcp-version = "0.2.1";

  settingsFormat = pkgs.formats.yaml { };

  dshHome =
    if config.programs.dsh.home != null then
      config.programs.dsh.home
    else
      "${config.home.homeDirectory}/.dsh";

  settingsFile = settingsFormat.generate "dsh-settings.yaml" cfg.settings;

  yq = lib.getExe pkgs.yq-go;

  # Same derivations ../claude-code builds, so these exist with claude-code off.
  weather = pkgs.writeShellApplication {
    name = "weather";
    runtimeInputs = with pkgs; [
      curl
      jq
      coreutils
      util-linux
    ];
    text = builtins.readFile ./../claude-code/weather/weather.sh;
  };

  intervals-icu = pkgs.writeShellApplication {
    name = "intervals-icu";
    runtimeInputs = with pkgs; [
      curl
      jq
      coreutils
    ];
    text = builtins.readFile ./../claude-code/intervals-icu.sh;
  };

  intervals-icu-mcp = pkgs.callPackage ./../claude-code/intervals-icu/package.nix { };

  coachSkills = (import ./../claude-code/coach { inherit pkgs; }).skills;
  patheSkills = (import ./../claude-code/pathe { inherit pkgs; }).skills;
  boxdSkills =
    (import ./../claude-code/boxd {
      inherit pkgs;
      inherit (config.apps.boxd) user;
    }).skills;
  ledgerSkills = (import ./../claude-code/ledger { inherit pkgs; }).skills;
  fontysSkills = (import ./../claude-code/fontys { inherit pkgs; }).skills;
  fontysCoachSkills = (import ./../claude-code/fontys-coach { inherit pkgs; }).skills;
  typstWriterSkills = (import ./../claude-code/typst-writer { inherit pkgs; }).skills;

  # Nothing in dsh asks before `canvas assignment` or plain `ledger` (both
  # write); only the skill text does.
  canvasSubmitSkills = (import ./../claude-code/canvas-submit { inherit pkgs; }).skills;

  dsh-usage = pkgs.callPackage ./usage.nix { inherit (pkgs) dsh; };

  # To pin a bundle ahead of upstream, copy its package.nix and state the
  # pnpmDeps hash. Overriding `src` alone silently reuses upstream's pnpmDeps
  # FOD, whose name and hash don't change, and pnpm dies offline.

  # Upstream's check hook calls a bare `curl`, but its propagated curl is the
  # dev output (no bin/curl), so the web check times out. `lib.getBin` doesn't
  # reach installCheck's PATH either; an absolute path does.
  dsh-check-hook =
    pkgs.makeSetupHook
      {
        name = "dsh-bundle-check-hook";
        propagatedNativeBuildInputs = with pkgs; [
          coreutils
          util-linux
        ];
      }
      (
        pkgs.runCommand "dsh-bundle-check-hook.sh" { } ''
          substitute ${pkgs.dsh.dshBundleCheckHook}/nix-support/setup-hook "$out" \
            --replace-fail 'curl --fail' '${lib.getExe' pkgs.curl "curl"} --fail'
        ''
      );

  # Not overrideScope: withProfiles re-derives from package.nix's own `dsh`
  # argument, so that has to point back at this package to keep the hook.
  dsh-fixed =
    let
      self = pkgs.dsh.dsh.override {
        dsh = self;
        dshBundleCheckHook = dsh-check-hook;
      };
    in
    self;

  # A profile patch rather than programs.dsh.patch: that option renders through
  # lib.generators.toYAML, which would quote the `!!js` tags into inert strings.
  #
  # A patch REPLACES the targeted row's whole `config`, so any row touched here
  # restates every key it means to keep.
  cordisPatch = ''
    # Generated by home/programs/dsh/default.nix -- do not edit in place.

    # Off in the web profile; stated here so all three profiles match.
    - id: skill-filesystem
      disabled: false
      config:
        customSkillDirs:
          - ${coachSkills}
          - ${patheSkills}
          - ${boxdSkills}
          - ${ledgerSkills}
          - ${fontysSkills}
          - ${fontysCoachSkills}
          - ${typstWriterSkills}
          - ${canvasSubmitSkills}
    - id: tool-skill
      disabled: false

    # The tui bundle turns this off (dsh-tui/cordis.patch.yml:56).
    - id: agent-instructions
      disabled: false
      config:
        maxBytes: 65536

    # pi-ai has no `qwen-cloud` provider, so the whole provider is declared.
    # `input` and `reasoningEfforts` have no usable default for a hand-declared
    # model; "off" is quoted because a bare `off` is a YAML 1.1 boolean.
    # maxTokensField and supportsUsageInStreaming are stated because pi-ai
    # treats an endpoint it doesn't recognise as OpenAI itself.
    #
    # `dashscope-api-key` is the Singapore key: Model Studio keys only work in
    # the region that issued them.
    - id: llm-pi-ai
      config:
        providers:
          anthropic:
            apiKeyEnv: ANTHROPIC_API_KEY
          qwen-cloud:
            apiKeyEnv: DASHSCOPE_API_KEY
            displayName: Qwen Cloud
            api: openai-completions
            baseURL: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
            models:
              - id: qwen3.8-27b
                name: Qwen3.8 27B
                contextWindow: 1000000
                maxTokens: 131072
                input:
                  - text
                  - image
                reasoningEfforts:
                  "off": null
                  low: low
                  medium: medium
                  high: high
                compat:
                  thinkingFormat: qwen
                  maxTokensField: max_tokens
                  supportsUsageInStreaming: true
                  # pi-ai sends the system prompt under the `developer` role to
                  # any model that declares reasoning, and DashScope answers
                  # 400. false keeps `system`.
                  supportsDeveloperRole: false

    - insert:
        # Credentials come from the dsh() env below; this file is
        # world-readable in the store.
        - id: mcp-cronometer
          name: '@deepseek-ai/dsh-mcp-client'
          config:
            serverName: cronometer
            transport: stdio
            command: ${lib.getExe' pkgs.uv "uvx"}
            args:
              - '--python'
              - '${pkgs.python314}/bin/python3'
              - 'cronometer-api-mcp==${cronometer-mcp-version}'
            env:
              # An unset variable resolves to undefined and fails the whole
              # boot; `?? '''` turns it into an auth failure on this server.
              CRONOMETER_USERNAME: !!js process.env.CRONOMETER_USERNAME ?? '''
              CRONOMETER_PASSWORD: !!js process.env.CRONOMETER_PASSWORD ?? '''
              CRONOMETER_ACCOUNT_TZ: Europe/Amsterdam
              UV_PYTHON_DOWNLOADS: never

        # No per-tool prompts here, so `upload_week_plan` (and its `clear`,
        # which deletes the existing calendar range) runs unasked.
        - id: mcp-intervals-icu
          name: '@deepseek-ai/dsh-mcp-client'
          config:
            serverName: intervals-icu
            transport: stdio
            command: ${lib.getExe intervals-icu-mcp}
            env:
              INTERVALS_API_KEY: !!js process.env.INTERVALS_API_KEY ?? '''
              ATHLETE_ID: i563199
  '';
  # The TUI profile always carries a web host. `port: 0` keeps a second TUI or
  # the dsh-web unit from hitting EADDRINUSE on 3080. Not in cordisPatch
  # because headless has no webserver row, and patching a missing row warns.
  tuiPatch = ''
    - id: webserver
      config:
        host: !!js ctx.webStartup.host ?? '127.0.0.1'
        port: !!js ctx.webStartup.port ?? 0
        compression: gzip
        compressionLevel: 1
        compressionThresholdBytes: 1024

    # A foreground run inherits BROWSER, so every TUI launch opened a tab.
    # printUrl must stay true: dshBundleCheckHook greps the boot log for the
    # `dsh web: <url>` line it prints.
    - id: web-runtime
      config:
        openBrowser: false
        printUrl: true
        surfaceContext: true
        trustedHosts: !!js ctx.webStartup.trustedHosts
  '';

  # dsh-TUI's peerDependencies stop before this kernel, so dsh refuses to load
  # it, though mk-dsh-bundle builds it against this exact kernel. A grant only
  # matches an exact pair, so both versions are interpolated and a bump
  # re-grants. Keys are npm names, not Nix attribute names.
  bundleVersionExemptions = {
    nix-tui = {
      "@deepseek-harness-tui/dsh-tui" = pkgs.dsh.bundles.tui.version;
    };
  };

  exemptionFile =
    grants:
    pkgs.writeText "dsh-version-exemptions.json" (
      builtins.toJSON (
        lib.mapAttrs' (
          name: version: lib.nameValuePair "${name}@${version}" [ pkgs.dsh.dsh.version ]
        ) grants
      )
    );

in
{
  options.apps.dsh = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable DeepSeek Harness (dsh)";
    };

    settings = lib.mkOption {
      type = settingsFormat.type;
      default = { };
      example = lib.literalExpression ''
        {
          some-plugin = {
            command = "some-plugin-server";
            recallBudgetTokens = 1200;
          };
        }
      '';
      description = ''
        Declared `$DSH_HOME/settings.yaml` entries, keyed by the namespace each
        plugin registers. Merged into the existing file on activation: declared
        keys win, everything else the web UI wrote is left alone.

        This is the escape hatch for plugins that register their configuration
        through the settings service instead of a Cordis config schema -- those
        cannot be reached from the profile patch at all.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    apps.dsh.settings = {
      agent-default-model = {
        provider = "deepseek-official";
        model = "deepseek-flash";
      };
    };

    home.file."${dshHome}/AGENTS.md".source = ../claude-code/context.md;

    programs.dsh = {
      enable = true;

      package = dsh-fixed;

      profiles = {
        tui = {
          bundles = [
            pkgs.dsh.bundles.tui
            pkgs.dsh.bundles.graph-memory
            pkgs.dsh.bundles.modsearch
            pkgs.dsh.bundles.context
            dsh-usage
          ];
          patch = cordisPatch + tuiPatch;
        };
        web = {
          bundles = [
            pkgs.dsh.bundles.web-app
            pkgs.dsh.bundles.graph-memory
            pkgs.dsh.bundles.modsearch
            pkgs.dsh.bundles.context
            pkgs.dsh.bundles.turn-rewind
            pkgs.dsh.bundles.experimental-forge-bundle
          ];
          patch = cordisPatch;
        };
        headless = {
          bundles = [ pkgs.dsh.bundles.headless ];
          patch = cordisPatch;
        };
      };

      defaultProfile = config.programs.dsh.profiles.web.materializedName;
    };

    # Not autostarted: idle it costs ~275 MB and holds 3080 open,
    # unauthenticated, with a live API key. `systemctl --user start dsh-web`.
    # --no-open because the unit inherits BROWSER from the session manager.
    services.dsh = {
      enable = true;
      autoStart = false;
      extraArguments = [ "--no-open" ];
      environmentFile = "/run/secrets/rendered/dsh-env";
    };

    # dsh has no file-based credential path (`!!js` has no `require`, the MCP
    # client no envFile), so keys have to be environment variables. A function
    # rather than login exports keeps them out of every other process.
    # ANTHROPIC_API_KEY has no sops secret yet; the -r guard leaves it unset.
    programs.bash.initExtra = lib.mkAfter ''
      dsh() {
        local pair var file
        for pair in \
          "DEEPSEEK_API_KEY=/run/secrets/deepseek-api-key" \
          "DASHSCOPE_API_KEY=/run/secrets/dashscope-api-key" \
          "CRONOMETER_USERNAME=/run/secrets/cronometer-email" \
          "CRONOMETER_PASSWORD=/run/secrets/cronometer-password" \
          "INTERVALS_API_KEY=/run/secrets/intervals_icu_key" \
          "ANTHROPIC_API_KEY=/run/secrets/anthropic-api-key"
        do
          var=''${pair%%=*}
          file=''${pair#*=}
          if [ -z "''${!var:-}" ] && [ -r "$file" ]; then
            local -x "''${var?}"
            printf -v "$var" '%s' "$(< "$file")"
          fi
        done
        command dsh "$@"
      }
    '';

    # Merged rather than linked: the web UI writes to settings.yaml.
    home.activation.dshSettings = lib.mkIf (cfg.settings != { }) (
      lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        dsh_settings=${lib.escapeShellArg "${dshHome}/settings.yaml"}
        $DRY_RUN_CMD mkdir -p "$(dirname "$dsh_settings")"
        if [ -e "$dsh_settings" ]; then
          $DRY_RUN_CMD ${yq} eval-all --inplace \
            'select(fileIndex == 0) * select(fileIndex == 1)' \
            "$dsh_settings" ${settingsFile}
        else
          $DRY_RUN_CMD install -m 0644 ${settingsFile} "$dsh_settings"
        fi
      ''
    );

    # After "dsh", which creates the profile directories: the seeder won't
    # adopt one created here. An unparseable file is replaced, since dsh reads
    # it as granting nothing anyway.
    home.activation.dshBundleExemptions = lib.hm.dag.entryAfter [ "writeBoundary" "dsh" ] (
      lib.concatStringsSep "\n" (
        lib.mapAttrsToList (profile: grants: ''
          compat=${lib.escapeShellArg "${dshHome}/profiles/${profile}/compatibility.json"}
          if [ -e "$compat" ] && $DRY_RUN_CMD ${yq} -e '.' "$compat" >/dev/null 2>&1; then
            $DRY_RUN_CMD ${yq} eval-all --inplace \
              'select(fileIndex == 0) + select(fileIndex == 1)' \
              "$compat" ${exemptionFile grants}
          else
            $DRY_RUN_CMD install -m 0644 ${exemptionFile grants} "$compat"
          fi
        '') bundleVersionExemptions
      )
    );

    # The coach skill calls these through the bash tool.
    home.packages = [
      weather
      intervals-icu
    ];
  };
}
